# Copy to .deploy.env for local deployment verification.
# Do not commit .deploy.env.

# Required for building the PWA with Clerk.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Required Worker secrets.
PUBLISH_TOKEN="reuse-dev-token-or-generate-a-long-random-token"
CLERK_SECRET_KEY="sk_test_..."
CLERK_JWT_ISSUER="https://your-clerk-instance.clerk.accounts.dev"

# Required after the Worker is deployed, for post-deploy verification.
BEACHCAR_DEPLOY_URL="https://beachcar-watch.<your-workers-subdomain>.workers.dev"

# Optional: lets the verifier exercise signed-in APIs after deploy.
BEACHCAR_CLERK_TOKEN=""
BEACHCAR_MCP_TOKEN=""

# Optional: required before proving real remote AI Gateway spend and budgets.
BEACHCAR_AI_GATEWAY_TOKEN=""
BEACHCAR_AI_GATEWAY_BASE_URL=""
BEACHCAR_AI_GATEWAY_ID=""
CLOUDFLARE_ACCOUNT_ID=""
