# Copy to .deploy.env for local deployment validation and verification.
# Do not commit .deploy.env. Do not put secret values on command lines.

# Required production account. The rollout checks this value against Wrangler's
# authenticated account before any remote mutation.
CLOUDFLARE_ACCOUNT_ID="b8873e78bf5e48fcdc91e87f2324cf55"

# Wrangler authentication only. Prefer `wrangler login`; if a scoped API token is
# needed for automation, inject it securely. This value is never a Worker secret.
CLOUDFLARE_API_TOKEN=""

# Required for building the PWA with Clerk.
VITE_CLERK_PUBLISHABLE_KEY=""

# Keep checkout disabled during the private pilot. Change this to true only
# after the production Clerk Billing + Stripe launch is deliberately approved.
VITE_MANAGED_RESEARCH_CHECKOUT_ENABLED="false"

# Required secret names on the remote Worker. Local values are optional when the
# remote values are already correct. Any supplied values deploy atomically with
# the Worker; omitted secrets are preserved.
PUBLISH_TOKEN=""
CLERK_SECRET_KEY=""
CLERK_JWT_ISSUER=""
# Required later when production checkout is enabled.
CLERK_WEBHOOK_SIGNING_SECRET=""

# Optional comma-separated private-pilot cohort. Bootstrap owners already have
# Managed Research access and do not need to be repeated here.
BEACHCAR_MANAGED_PILOT_EMAILS=""

# Deployed production URL used by post-deploy verification.
BEACHCAR_DEPLOY_URL="https://beachcar-watch.jon-cooper.workers.dev"

# Managed-pilot verifier identity and the one explicitly trusted legacy origin
# where the already-created Clerk ticket URL was stored. The verifier extracts
# only __clerk_ticket and redeems it on BEACHCAR_DEPLOY_URL; it never navigates
# to this legacy origin.
BEACHCAR_EXPECTED_PILOT_EMAIL=""
BEACHCAR_TRUSTED_LEGACY_TICKET_ORIGIN="https://beach-car-watch.jon-cooper.workers.dev"

# Optional verifier credentials. Requirement flags fail closed when their token
# is missing: --require-clerk, --require-publish, --require-mcp, or the aggregate
# --require-authenticated.
BEACHCAR_CLERK_TOKEN=""
BEACHCAR_MCP_TOKEN=""

# Required runner choice. Managed Research never uses deterministic scoring;
# this only controls browser/container task execution. Switching to codex also
# requires --deploy-containers and an OPENAI_API_KEY supplied here.
BEACHCAR_RUNNER_MODE="deterministic"
BEACHCAR_CODEX_MODEL=""
OPENAI_API_KEY=""

# Required before granting Managed Research pilot access. Agent-connected MCP
# curation does not use this token. CLOUDFLARE_API_TOKEN remains reserved for
# Wrangler authentication.
BEACHCAR_AI_GATEWAY_TOKEN=""
BEACHCAR_AI_GATEWAY_BASE_URL=""
BEACHCAR_AI_GATEWAY_ID=""
