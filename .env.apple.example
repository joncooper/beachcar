# Copy to .env.apple.local and fill in the values from Apple Developer / App Store Connect.
# Do not commit .env.apple.local or private key files.

# Optional but recommended. This is the 10-character Apple Developer Team ID.
# If omitted, xcodebuild may infer the team from the App Store Connect API key when only one team is available.
APPLE_TEAM_ID=

# App Store Connect API key. Create this in App Store Connect > Users and Access > Integrations.
# Store the downloaded key as ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8

# App identity. The app record in App Store Connect must use this bundle ID.
IOS_BUNDLE_ID=com.joncooper.beachcar
IOS_APP_NAME=Beachcar
IOS_SKU=beachcar-ios
IOS_PRIMARY_LOCALE=en-US

# Versioning. IOS_BUILD_NUMBER must increase for every TestFlight upload.
IOS_MARKETING_VERSION=0.1.0
# IOS_BUILD_NUMBER=202606231200

# TestFlight. YES makes builds internal-test-only, which is good for private development.
TESTFLIGHT_INTERNAL_ONLY=YES
# Assign uploaded internal builds to this beta group after upload.
TESTFLIGHT_BETA_GROUP_NAME="Beachcar Internal"
TESTFLIGHT_ASSIGN_INTERNAL_GROUP=YES

# Optional manual signing settings. Quote values that contain spaces.
# IOS_PROVISIONING_PROFILE_NAME="Beachcar App Store 2026-06-23"
# IOS_SIGNING_CERTIFICATE="Apple Distribution"

# Output locations.
# IOS_ARCHIVE_PATH=build/ios/Beachcar.xcarchive
# IOS_EXPORT_PATH=build/ios/export
