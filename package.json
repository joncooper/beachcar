{
  "name": "beachcar",
  "private": true,
  "version": "0.1.0",
  "description": "A Cloudflare-hosted auction watch PWA operated by a daily AI research automation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run typecheck:client && npm run typecheck:worker && npm run typecheck:tests",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "deploy": "WRANGLER_LOG_PATH=$PWD/.wrangler-logs wrangler deploy",
    "cf:types": "wrangler types src/worker/generated-env.d.ts --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply beachcar-watch --local",
    "db:migrate:remote": "wrangler d1 migrations apply beachcar-watch --remote",
    "publish:daily": "node scripts/publish-daily-run.mjs",
    "images:audit": "node scripts/audit-image-cache.mjs",
    "ios:generate": "xcodegen generate --spec ios/project.yml",
    "ios:resolve": "xcodebuild -resolvePackageDependencies -project ios/Beachcar.xcodeproj -scheme Beachcar",
    "ios:build": "scripts/ios-build.sh",
    "ios:sim": "scripts/ios-run-sim.sh",
    "ios:test-ui": "scripts/ios-test-ui.sh",
    "ios:icons": "scripts/ios-generate-icons.sh",
    "ios:archive": "scripts/ios-archive.sh",
    "ios:testflight": "scripts/ios-upload-testflight.sh",
    "ios:testflight:assign": "node scripts/ios-assign-testflight-group.mjs",
    "ios:release": "scripts/ios-archive.sh && scripts/ios-upload-testflight.sh",
    "ios:asc:check": "scripts/ios-appstore-check.sh"
  },
  "dependencies": {
    "@clerk/react": "^6.10.4",
    "@vitejs/plugin-react": "^5.1.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260619.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.55.0"
  }
}
