{
  "name": "beachcar",
  "private": true,
  "version": "0.1.0",
  "description": "A Cloudflare-hosted auction watch PWA operated by a daily AI research automation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-client.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "bun run typecheck:client && bun run typecheck:worker && bun run typecheck:tests",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "deploy": "WRANGLER_LOG_PATH=$PWD/.wrangler-logs wrangler deploy",
    "cf:types": "WRANGLER_LOG_PATH=$PWD/.wrangler-logs wrangler types /tmp/beachcar-wrangler-types.d.ts --include-runtime false --env-interface BaseEnv",
    "db:migrate:local": "bun scripts/apply-d1-migrations.mjs --local",
    "db:migrate:remote": "bun scripts/apply-d1-migrations.mjs --remote",
    "publish:daily": "bun scripts/publish-daily-run.mjs",
    "agent:run-local": "bun scripts/run-agent-job-local.mjs",
    "runner-task:local": "bun scripts/run-runner-task-local.mjs",
    "container-runner:check": "node --check runner/runner-server.mjs",
    "container-runner:dev": "bun runner/runner-server.mjs",
    "smoke:local-worker": "bun scripts/smoke-local-worker.mjs",
    "preflight": "bun scripts/preflight-local.mjs",
    "preflight:local": "bun scripts/preflight-local.mjs --smoke",
    "preflight:full": "bun scripts/preflight-local.mjs --smoke --ios",
    "deploy:check": "bun scripts/check-deploy-readiness.mjs",
    "deploy:env:check": "bun scripts/validate-deploy-env.mjs",
    "cloudflare:check": "bun scripts/check-cloudflare-resources.mjs",
    "cloudflare:plan": "bun scripts/plan-cloudflare-deploy.mjs",
    "cloudflare:bootstrap": "bun scripts/bootstrap-cloudflare-rollout.mjs",
    "cloudflare:verify": "bun scripts/verify-cloudflare-deploy.mjs",
    "images:audit": "bun scripts/audit-image-cache.mjs",
    "ios:generate": "xcodegen generate --spec ios/project.yml",
    "ios:resolve": "xcodebuild -resolvePackageDependencies -project ios/Beachcar.xcodeproj -scheme Beachcar",
    "ios:build": "scripts/ios-build.sh",
    "ios:sim": "scripts/ios-run-sim.sh",
    "ios:test-ui": "scripts/ios-test-ui.sh",
    "ios:icons": "scripts/ios-generate-icons.sh",
    "ios:archive": "scripts/ios-archive.sh",
    "ios:testflight": "scripts/ios-upload-testflight.sh",
    "ios:testflight:assign": "bun scripts/ios-assign-testflight-group.mjs",
    "ios:release": "scripts/ios-archive.sh && scripts/ios-upload-testflight.sh",
    "ios:asc:check": "scripts/ios-appstore-check.sh"
  },
  "dependencies": {
    "@clerk/react": "^6.10.4",
    "@cloudflare/containers": "^0.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "agents": "^0.16.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260619.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.105.0"
  }
}
