{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beachcar-watch",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "dev": {
    "enable_containers": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "containers": [
    {
      "class_name": "BeachcarRunnerContainer",
      "image": "./runner/Dockerfile",
      "image_build_context": "./runner",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": [10, 100]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BeachcarAgent",
        "class_name": "BeachcarAgent"
      },
      {
        "name": "BEACHCAR_RUNNER_CONTAINER",
        "class_name": "BeachcarRunnerContainer"
      }
    ]
  },
  "workflows": [
    {
      "name": "beachcar-run-workflow",
      "binding": "BEACHCAR_RUN_WORKFLOW",
      "class_name": "BeachcarRunWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BeachcarAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BeachcarRunnerContainer"]
    }
  ],
  "vars": {
    "BOOTSTRAP_OWNER_EMAILS": "jon.cooper@gmail.com,jon@dockett.ai",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beach-car-watch",
      "database_id": "2860a6be-7cf0-4fc0-821f-166e78521154",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "beachcar-watch-images"
    }
  ]
}
